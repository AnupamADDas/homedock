[Unit]
Description=HomeDock — Lightweight Web-Based Server Manager
After=network.target network-online.target
Wants=network-online.target

[Service]
# NOTE: Run `./deploy/install-service.sh --system` to configure and install automatically,
# or replace 'YOUR_USER' and '/path/to/homedock' below with your actual values.
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/path/to/homedock
ExecStart=/path/to/homedock/run.sh
Restart=always
RestartSec=3
KillMode=process
TimeoutStopSec=10
NoNewPrivileges=true
LimitNOFILE=65535

# Environment
Environment=HOMEDOCK_HOST=0.0.0.0
Environment=HOMEDOCK_PORT=8090
Environment=PYTHONPATH=/path/to/homedock
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
